{
  "name": "claude-code-multi-provider-switcher",
  "displayName": "Claude Multi-Provider Switcher",
  "description": "Switch Claude Code between subscription accounts AND third-party API providers (DeepSeek, OpenRouter, Kimi, GLM, Qwen, MiniMax, Ollama, ...), each with its own API key and models.",
  "version": "0.3.0",
  "publisher": "Heisenbear-Rebirth",
  "author": {
    "name": "Heisenbear-Rebirth"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "account",
    "switcher",
    "usage",
    "limits",
    "api provider",
    "deepseek",
    "openrouter",
    "kimi",
    "glm",
    "qwen",
    "minimax",
    "ollama",
    "base url",
    "api key"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Heisenbear-Rebirth/claude-account-switcher"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeProviderSwitcher",
          "title": "Claude Providers",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeProviderSwitcher": [
        {
          "id": "claudeProviderSwitcher.accountsView",
          "name": "Accounts & Providers",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeProviderSwitcher.addCurrentAccount",
        "title": "Claude: Save current account as profile",
        "icon": "$(add)"
      },
      {
        "command": "claudeProviderSwitcher.switchAccount",
        "title": "Claude: Switch account",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "claudeProviderSwitcher.refreshUsage",
        "title": "Claude: Refresh usage limits",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeProviderSwitcher.sayHi",
        "title": "Claude: Say Hi / test provider connection",
        "icon": "$(comment)"
      },
      {
        "command": "claudeProviderSwitcher.openIndependentWindow",
        "title": "Claude: Open independent account window",
        "icon": "$(window)"
      },
      {
        "command": "claudeProviderSwitcher.login",
        "title": "Claude: Log in from terminal",
        "icon": "$(sign-in)"
      },
      {
        "command": "claudeProviderSwitcher.browserLogin",
        "title": "Claude: Authorize in browser (without CLI)",
        "icon": "$(globe)"
      },
      {
        "command": "claudeProviderSwitcher.reauthorizeProfile",
        "title": "Claude: Reauthorize account profile",
        "icon": "$(sign-in)"
      },
      {
        "command": "claudeProviderSwitcher.completeProfileReauthorization",
        "title": "Claude: Complete profile reauthorization",
        "icon": "$(pass)"
      },
      {
        "command": "claudeProviderSwitcher.removeAccount",
        "title": "Claude: Remove account profile"
      },
      {
        "command": "claudeProviderSwitcher.renameAccount",
        "title": "Claude: Rename account profile"
      },
      {
        "command": "claudeProviderSwitcher.undoSwitch",
        "title": "Claude: Undo last switch"
      },
      {
        "command": "claudeProviderSwitcher.openPanel",
        "title": "Claude: Show accounts panel"
      },
      {
        "command": "claudeProviderSwitcher.addProviderProfile",
        "title": "Claude: Add API provider profile",
        "icon": "$(plug)"
      },
      {
        "command": "claudeProviderSwitcher.editProviderProfile",
        "title": "Claude: Edit API provider profile",
        "icon": "$(settings-gear)"
      },
      {
        "command": "claudeProviderSwitcher.setCompatGroup",
        "title": "Claude: Set conversation compatibility group",
        "icon": "$(link)"
      },
      {
        "command": "claudeProviderSwitcher.importFromUpstream",
        "title": "Claude: Import profiles from claude-account-switcher",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeProviderSwitcher.addCurrentAccount",
          "when": "view == claudeProviderSwitcher.accountsView",
          "group": "navigation@1"
        },
        {
          "command": "claudeProviderSwitcher.addProviderProfile",
          "when": "view == claudeProviderSwitcher.accountsView",
          "group": "navigation@1.5"
        },
        {
          "command": "claudeProviderSwitcher.refreshUsage",
          "when": "view == claudeProviderSwitcher.accountsView",
          "group": "navigation@2"
        },
        {
          "command": "claudeProviderSwitcher.sayHi",
          "when": "view == claudeProviderSwitcher.accountsView",
          "group": "navigation@3"
        },
        {
          "command": "claudeProviderSwitcher.openIndependentWindow",
          "when": "view == claudeProviderSwitcher.accountsView",
          "group": "navigation@4"
        },
        {
          "command": "claudeProviderSwitcher.login",
          "when": "view == claudeProviderSwitcher.accountsView",
          "group": "navigation@5"
        },
        {
          "command": "claudeProviderSwitcher.browserLogin",
          "when": "view == claudeProviderSwitcher.accountsView",
          "group": "navigation@5.5"
        },
        {
          "command": "claudeProviderSwitcher.reauthorizeProfile",
          "when": "view == claudeProviderSwitcher.accountsView",
          "group": "navigation@6"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeProviderSwitcher.removeAccount"
        },
        {
          "command": "claudeProviderSwitcher.renameAccount"
        },
        {
          "command": "claudeProviderSwitcher.editProviderProfile"
        },
        {
          "command": "claudeProviderSwitcher.setCompatGroup"
        },
        {
          "command": "claudeProviderSwitcher.importFromUpstream"
        }
      ]
    },
    "configuration": {
      "title": "Claude Multi-Provider Switcher",
      "properties": {
        "claudeProviderSwitcher.pollIntervalSeconds": {
          "type": "number",
          "default": 240,
          "minimum": 180,
          "markdownDescription": "How often (in seconds) to automatically refresh usage limits for each **subscription** account. The endpoint is heavily rate-limited - values below 180s are raised to 180s. API-provider profiles are never polled: third-party endpoints do not serve the usage API."
        },
        "claudeProviderSwitcher.autoReloadAfterSwitch": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Automatically reload the VS Code window after switching accounts (required for Claude Code to pick up the new account). When disabled, the extension asks first."
        },
        "claudeProviderSwitcher.credentialsPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Claude Code `.credentials.json` file. Empty = default `~/.claude/.credentials.json`."
        },
        "claudeProviderSwitcher.warnThresholdPercent": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 100,
          "markdownDescription": "Usage threshold (%) above which the limit bar turns red."
        },
        "claudeProviderSwitcher.claudeCommand": {
          "type": "string",
          "default": "claude",
          "markdownDescription": "Claude Code CLI command used for login and Say Hi warmups. Use the full path to `claude.cmd`/`claude.exe` if VS Code cannot find `claude` in PATH."
        },
        "claudeProviderSwitcher.sayHiModel": {
          "type": "string",
          "default": "haiku",
          "markdownDescription": "Model passed to `claude -p` for Say Hi warmups on **subscription** profiles. `haiku` is the low-cost default. API-provider profiles ignore this and use their own configured model."
        },
        "claudeProviderSwitcher.sayHiPrompt": {
          "type": "string",
          "default": "Hi",
          "markdownDescription": "Prompt used by Say Hi warmups and by API-provider connection tests."
        },
        "claudeProviderSwitcher.sayHiTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 15,
          "markdownDescription": "Maximum time to wait for a Say Hi warmup command."
        },
        "claudeProviderSwitcher.warnOnIncompatibleSwitch": {
          "type": "string",
          "enum": [
            "always",
            "whenSessionsExist",
            "never"
          ],
          "enumDescriptions": [
            "Always confirm before switching between incompatible profiles.",
            "Only confirm when this folder already has conversations that would be affected.",
            "Never confirm."
          ],
          "default": "whenSessionsExist",
          "markdownDescription": "Confirm before switching to a profile that uses a different endpoint or model. Existing conversations cannot be continued across such a switch: transcripts replay `thinking` blocks whose signatures the new endpoint cannot validate, so they are rejected or silently dropped. Profiles that differ only by API key are always considered compatible and never prompt."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node test/run-smoke.cjs",
    "build:vsix": "npm run package && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  },
  "contributors": [
    {
      "name": "Krzysztof Zander",
      "email": "krzysztof.zander@retencja.pl",
      "url": "https://github.com/KrzysztofZander"
    }
  ]
}
